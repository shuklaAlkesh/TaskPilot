# TaskPilot frontend — example configuration (LOCAL DEVELOPMENT PLACEHOLDERS ONLY)
# Copy to .env.local for local use. In Vercel, set these as Sensitive environment variables.
# Server-only values: NEVER prefix them with NEXT_PUBLIC_ (that would ship them to the browser).
# Reference: docs/12-DEPLOYMENT-RUNBOOK.md §3 and §11

TASKPILOT_API_BASE_URL=http://localhost:8080
# 32 random bytes, base64. Example generator: `openssl rand -base64 32`
SESSION_SECRET=change-me-generate-32-random-bytes-base64
