{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpilot.dev/contracts/job.schema.json",
  "title": "TaskPilot job envelope (PROPOSED, schema_version 1)",
  "description": "Envelope Go sends to the Python worker in a claim response, plus the worker's outcome report bodies. Authoritative description: docs/03-TECHNICAL-DESIGN.md §6. Payload schemas are registered by workers (POST /internal/v1/workers, ADR-0009) from their pydantic models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "attempt_id", "attempt_no", "max_attempts",
    "task_type", "task_version", "timeout_seconds", "payload", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "format": "uuid", "description": "Stable across attempts; usable as an external idempotency key." },
    "attempt_id": { "type": "string", "format": "uuid", "description": "Fencing token for every report about this attempt." },
    "attempt_no": { "type": "integer", "minimum": 1, "maximum": 10 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "task_type": { "$ref": "#/$defs/TaskTypeName" },
    "task_version": { "type": "integer", "minimum": 1 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "payload": { "type": "object", "description": "Validated by Go against the payload_schema the worker registered for this task type version, before enqueue." },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "TaskTypeName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
      "maxLength": 100
    },
    "ErrorCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Reserved by the supervisor: timeout, handler_crashed, handler_error, invalid_result, result_too_large, worker_shutdown, unsupported_task."
    },
    "CompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "type": "object", "description": "≤ 64 KiB serialized." }
      }
    },
    "FailRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/ErrorCode" },
            "message": { "type": "string", "maxLength": 1000, "description": "Must not contain payload contents or secrets." },
            "retryable": { "type": "boolean" }
          }
        }
      }
    },
    "ChildOutput": {
      "description": "Single JSON line the handler subprocess writes to stdout.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "result"],
          "properties": { "ok": { "const": true }, "result": { "type": "object" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "error"],
          "properties": {
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/FailRequest/properties/error" }
          }
        }
      ]
    }
  }
}
