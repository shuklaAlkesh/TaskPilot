{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpilot.dev/contracts/task-types/text.word_count.v1.json",
  "title": "text.word_count v1 payload (PROPOSED)",
  "description": "Result: {\"words\": int, \"lines\": int, \"characters\": int, \"top_words\": [{\"word\": str, \"count\": int}] (≤ top_n)}. Words are lower-cased, split on Unicode whitespace, stripped of surrounding punctuation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 60000 },
    "top_n": { "type": "integer", "minimum": 0, "maximum": 50, "default": 10 }
  },
  "x-taskpilot": {
    "title": "Word count",
    "default_timeout_seconds": 30,
    "max_timeout_seconds": 120,
    "default_max_attempts": 3,
    "idempotent": true,
    "side_effects": false,
    "test_only": false
  }
}
