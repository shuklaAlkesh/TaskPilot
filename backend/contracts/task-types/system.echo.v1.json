{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpilot.dev/contracts/task-types/system.echo.v1.json",
  "title": "system.echo v1 payload (PROPOSED)",
  "description": "Returns {\"message\": <message>}. Smoke test.",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "x-taskpilot": {
    "title": "Echo",
    "default_timeout_seconds": 10,
    "max_timeout_seconds": 30,
    "default_max_attempts": 3,
    "idempotent": true,
    "side_effects": false,
    "test_only": false
  }
}
