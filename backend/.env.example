# TaskPilot — example configuration (LOCAL DEVELOPMENT PLACEHOLDERS ONLY)
# Copy to .env for local use. Never commit .env. Never put real credentials here.
# Backend only (Go server + Python worker). Frontend settings: frontend/.env.example
# Reference: docs/12-DEPLOYMENT-RUNBOOK.md §3

# ---------- Shared ----------
TASKPILOT_ENV=development
TASKPILOT_LOG_LEVEL=info
# Must be >= 32 random bytes in real environments, e.g. `openssl rand -base64 32`
TASKPILOT_WORKER_TOKEN=change-me-local-worker-token
TASKPILOT_ENABLE_TEST_TASKS=true

# ---------- Local PostgreSQL container (Compose) ----------
POSTGRES_USER=taskpilot_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=taskpilot
# Host port; change it if 5432 is already used on your machine (update both URLs below too)
POSTGRES_PORT=5432

# ---------- Go API (taskpilot-api) ----------
DATABASE_URL=postgres://taskpilot_app:change-me-local-only@localhost:5432/taskpilot?sslmode=disable
TASKPILOT_MIGRATE_DATABASE_URL=postgres://taskpilot_owner:change-me-local-only@localhost:5432/taskpilot?sslmode=disable
TASKPILOT_HTTP_ADDR=:8080
TASKPILOT_WORKER_API_ADDR=:8081
# TASKPILOT_WORKER_TOKEN_PREVIOUS=          # only during token rotation
TASKPILOT_DB_MAX_CONNS=10
TASKPILOT_LEASE_DURATION=30s
TASKPILOT_HEARTBEAT_INTERVAL=10s
TASKPILOT_REAPER_INTERVAL=15s
# How often each API replica looks for due schedules (recurring jobs).
TASKPILOT_SCHEDULER_INTERVAL=1s
TASKPILOT_ATTEMPT_DEADLINE_GRACE=30s
TASKPILOT_RETRY_BASE=5s
TASKPILOT_RETRY_CAP=10m
TASKPILOT_DEFAULT_MAX_ATTEMPTS=3
TASKPILOT_MAX_SCHEDULE_AHEAD=168h
TASKPILOT_IDEMPOTENCY_TTL=24h
TASKPILOT_RETENTION_SUCCEEDED=720h
TASKPILOT_RETENTION_FAILED=2160h
TASKPILOT_RETENTION_AUDIT=4320h
TASKPILOT_RATE_LIMIT_RPS=10
TASKPILOT_RATE_LIMIT_BURST=20
TASKPILOT_SUBMIT_RATE_LIMIT_RPS=5
TASKPILOT_SUBMIT_RATE_LIMIT_BURST=10
TASKPILOT_SHUTDOWN_READY_DELAY=5s
TASKPILOT_SHUTDOWN_TIMEOUT=20s

# ---------- Python worker (taskpilot-worker) — NO database settings ----------
TASKPILOT_API_INTERNAL_URL=http://localhost:8081
TASKPILOT_WORKER_CONCURRENCY=4
TASKPILOT_WORKER_POLL_INTERVAL_SECONDS=1
TASKPILOT_WORKER_SHUTDOWN_GRACE_SECONDS=25
TASKPILOT_WORKER_METRICS_ADDR=:9100
# Which handlers this worker runs ("module:attribute" of a TaskRegistry) and which queues it serves.
TASKPILOT_WORKER_APP=taskpilot_worker.handlers.builtin:registry
# TASKPILOT_WORKER_QUEUES=default,analytics        # empty = every queue the app's tasks route to
# Environment variables passed through to handler subprocesses (never the worker token).
# TASKPILOT_WORKER_CHILD_ENV=DJANGO_SETTINGS_MODULE
